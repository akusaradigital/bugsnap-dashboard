{
  "name": "bugsnap",
  "version": "0.17.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rimraf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:icons": "node scripts/build-icons.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/contracts/*.test.mjs\" \"tests/audits/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:contracts": "node --test \"tests/contracts/*.test.mjs\"",
    "test:audits": "node --test \"tests/audits/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:e2e": "playwright test",
    "gate:pre-push": "node scripts/pre-push-gate.mjs"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "motion": "^13.4.3",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "lighthouse": "^12.8.2",
    "next": "14.2.35",
    "postcss": "^8",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  }
}
